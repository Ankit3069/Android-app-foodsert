<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/sv_addshp"
    tools:context=".Shop.AddorEditShop">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            layout="@layout/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar"/>
        <ImageButton
            android:id="@+id/ibDeleteasset"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="end"
            android:gravity="center"
            android:scaleType="fitXY"
            android:textAlignment="center"
            android:visibility="gone"
            app:tint="@color/red" />

        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Shop Url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopurl_edt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="City">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopcity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Region">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopregion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:text="Select Shop Type"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_shoptype"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg"
            android:textAlignment="center"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="35dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/layout_padding"
            android:layout_marginHorizontal="35dp"
           >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopcuisine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:editable="false"
                android:focusable="false"
                android:hint="Enter Cuisine"
                android:importantForAutofill="no"
                android:inputType="none"
                android:longClickable="false"
                tools:ignore="Deprecated,HardcodedText,KeyboardInaccessibleWidget" />

        </com.google.android.material.textfield.TextInputLayout>




        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.google.android.material.textfield.TextInputLayout

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="25dp"
                android:hint="Latitude and Longitude">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/locedt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:id="@+id/locationimg"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="40dp"
                android:layout_marginRight="50dp"
                android:src="@drawable/baseline_location_on_24" />


        </RelativeLayout>




        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Detail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopdesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Shop Timing">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shoptiming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Shop Rating">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shoprating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textField4"
            android:layout_marginHorizontal="35dp"
            android:layout_marginTop="25dp"
            android:hint="Shop Price">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shopprice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/shoppb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/shopsubmit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="25dp"
            app:cardElevation="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Submit"
                android:textColor="@color/white"
                android:textSize="18dp" />

        </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>